{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node outil-dev/audit/audit.js --court 2>&1; node outil-dev/notify.js --court 2>&1; true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
